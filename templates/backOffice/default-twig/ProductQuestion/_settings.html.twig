{% set domain = 'productquestion.bo.default-twig' %}

{# The shop's choices about the block. One form, one POST: the settings the next versions add
   go here as further fields. #}
<form method="POST" action="{{ path('productquestion_module_settings') }}" class="card card-body mb-3" data-testid="product-question-settings">
    <input type="hidden" name="_token" value="{{ csrfToken }}">
    <div class="form-check form-switch mb-2">
        <input class="form-check-input" type="checkbox" role="switch" id="pq-questions-closed" name="questions_closed" value="1" {{ questionsClosed ? 'checked' : '' }}>
        <label class="form-check-label" for="pq-questions-closed">{{ 'Close the whole shop to new questions'|trans({}, domain) }}</label>
    </div>
    <p class="text-muted small mb-2">{{ 'The questions already published stay on the product pages. A product can also be closed on its own, from the Modules tab of its edit page.'|trans({}, domain) }}</p>
    <div class="form-check form-switch mb-2">
        <input class="form-check-input" type="checkbox" role="switch" id="pq-allow-customer-answers" name="allow_customer_answers" value="1" {{ allowsCustomerAnswers ? 'checked' : '' }}>
        <label class="form-check-label" for="pq-allow-customer-answers">{{ 'Let customers answer the published questions'|trans({}, domain) }}</label>
    </div>
    <p class="text-muted small mb-2">{{ 'Their answers wait for your approval before they appear on the product page.'|trans({}, domain) }}</p>
    <div class="form-check form-switch mb-2">
        <input class="form-check-input" type="checkbox" role="switch" id="pq-all-languages" name="show_all_languages" value="1" {{ showsAllLanguages ? 'checked' : '' }}>
        <label class="form-check-label" for="pq-all-languages">{{ 'Show the questions of every language on the product pages'|trans({}, domain) }}</label>
    </div>
    <p class="text-muted small mb-2">{{ 'Each question then says the language it was asked in. Off, a page shows the questions of the language it is read in.'|trans({}, domain) }}</p>
    <div class="row g-2 mb-2">
        <div class="col-auto">
            <label class="form-label" for="pq-questions-per-page">{{ 'Questions per page on the product page'|trans({}, domain) }}</label>
            <input class="form-control" type="number" min="0" max="100" step="1" id="pq-questions-per-page" name="questions_per_page" value="{{ questionsPerPage }}" aria-describedby="pq-questions-per-page-help">
            <p class="text-muted small mb-0" id="pq-questions-per-page-help">{{ '0 shows every question on one page. Above that, a "Show more" link loads the next ones.'|trans({}, domain) }}</p>
        </div>
        <div class="col-auto">
            <label class="form-label" for="pq-search-threshold">{{ 'Offer a search above this number of published questions'|trans({}, domain) }}</label>
            <input class="form-control" type="number" min="0" max="10000" step="1" id="pq-search-threshold" name="search_threshold" value="{{ searchThreshold }}" aria-describedby="pq-search-threshold-help">
            <p class="text-muted small mb-0" id="pq-search-threshold-help">{{ '0 never offers a search. The search looks into the questions and their published answers.'|trans({}, domain) }}</p>
        </div>
    </div>
    <div>
        <button type="submit" class="btn btn-sm btn-primary" data-testid="product-question-settings-save">{{ 'Save the settings'|trans({}, domain) }}</button>
    </div>
</form>
