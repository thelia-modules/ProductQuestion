{# Top-level entry in the side navigation, injected through main.in-top-menu-items. #}
{% set domain = 'productquestion.bo.default-twig' %}
{% set is_active = admin_current_location is defined and admin_current_location starts with 'productquestion_module' %}
<li class="nav-item" data-testid="bo-nav-product-question">
    <a class="nav-link d-flex align-items-center {{ is_active ? 'active' : '' }}" title="{{ 'Customer questions'|trans({}, domain) }}" href="{{ path('productquestion_module_list') }}" id="top_menu_product_question">
        <i class="bi bi-chat-left-text me-2" aria-hidden="true"></i>
        <span class="item-text">{{ 'Customer questions'|trans({}, domain) }}</span>
        {% if pendingCount > 0 %}
            <span class="bo-side-nav__badge bo-side-nav__badge--warning ms-auto" data-testid="bo-nav-product-question-pending">
                {{ pendingCount }}<span class="visually-hidden"> {{ 'waiting for moderation'|trans({}, domain) }}</span>
            </span>
        {% endif %}
    </a>
</li>
