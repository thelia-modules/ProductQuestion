{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% set domain = 'productquestion.bo.default-twig' %}

{% block title %}{{ 'Customer question'|trans({}, domain) }}{% endblock %}
{% block body_testid %}product-question-edit-page{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans({}, domain) }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('productquestion_module_list') }}">{{ 'Customer questions'|trans({}, domain) }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">#{{ question.id }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    <div class="container-fluid" data-testid="product-question-edit-content">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="h3 mb-0">{{ 'Customer question'|trans({}, domain) }}</h1>
            <span class="badge text-bg-{{ questionStatus.css }}" data-testid="product-question-status">{{ questionStatus.label }}</span>
        </div>

        <div class="row g-3">
            <div class="col-lg-7">
                <div class="card mb-3">
                    <div class="card-header">{{ 'The question'|trans({}, domain) }}</div>
                    <div class="card-body">
                        <p class="mb-3" data-testid="product-question-content">{{ question.content|nl2br }}</p>
                        <p class="text-muted mb-0">
                            {{ 'Asked on'|trans({}, domain) }}
                            {{ question.createdAt ? question.createdAt|date('d/m/Y H:i') : '' }}
                            — {{ 'Language'|trans({}, domain) }} {{ question.locale }}
                        </p>
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>{{ 'Answer from the shop'|trans({}, domain) }}</span>
                        {% if officialAnswer %}
                            <span class="text-muted small" data-testid="product-question-official-helpful">{{ 'Found helpful by %count% customer(s)'|trans({'%count%': officialAnswer.helpfulCount}, domain) }}</span>
                        {% endif %}
                    </div>
                    <div class="card-body">
                        {# The theme's form theme, as its own edit screens apply it: without it the
                           row renders with Twig's bare layout, label beside a narrow textarea. #}
                        {% form_theme form with bo_form_themes only %}
                        {{ form_start(form, {action: path('productquestion_module_answer', {id: question.id}), method: 'POST', attr: {'data-testid': 'product-question-answer-form'}}) }}
                            {{ form_row(form.answer) }}
                            <button type="submit" class="btn btn-primary" data-testid="product-question-publish">
                                {{ officialAnswer ? 'Update the answer'|trans({}, domain) : 'Publish the answer'|trans({}, domain) }}
                            </button>
                        {{ form_end(form) }}

                        <p class="text-muted mt-3 mb-0">
                            {{ 'Publishing an answer puts the question on the product page.'|trans({}, domain) }}
                        </p>
                    </div>
                </div>

                <div class="card" data-testid="product-question-customer-answers">
                    <div class="card-header">{{ 'Answers from customers'|trans({}, domain) }}</div>
                    {% if customerAnswers is empty %}
                        <div class="card-body text-muted">{{ 'No customer has answered this question.'|trans({}, domain) }}</div>
                    {% else %}
                        <ul class="list-group list-group-flush">
                            {% for answer in customerAnswers %}
                                <li class="list-group-item" data-testid="product-question-customer-answer-{{ answer.id }}">
                                    <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
                                        <span class="badge text-bg-{{ answer.status.css }}" data-testid="product-question-answer-status-{{ answer.id }}">{{ answer.status.label }}</span>
                                        <span class="text-muted small">
                                            {{ answer.createdAt ? answer.createdAt|date('d/m/Y H:i') : '' }}
                                            · {{ 'Found helpful by %count% customer(s)'|trans({'%count%': answer.helpfulCount}, domain) }}
                                            {% if answer.customerUrl %}
                                                · <a href="{{ answer.customerUrl }}">{{ 'Open the customer record'|trans({}, domain) }}</a>
                                            {% else %}
                                                · {{ 'Deleted account'|trans({}, domain) }}
                                            {% endif %}
                                        </span>
                                    </div>
                                    <p class="mb-2">{{ answer.content|nl2br }}</p>
                                    <div class="d-flex gap-2">
                                        {% for decision in ['publish', 'refuse', 'delete'] %}
                                            {% if not (decision == 'publish' and answer.status.value == 1) and not (decision == 'refuse' and answer.status.value == 2) %}
                                                <form method="POST" action="{{ path('productquestion_module_moderate_answer', {answerId: answer.id, decision: decision}) }}">
                                                    <input type="hidden" name="_token" value="{{ csrfToken }}">
                                                    <button type="submit" class="btn btn-sm {{ decision == 'publish' ? 'btn-outline-success' : (decision == 'refuse' ? 'btn-outline-danger' : 'btn-outline-secondary') }}" data-testid="product-question-answer-{{ decision }}-{{ answer.id }}">
                                                        {{ {publish: 'Publish', refuse: 'Refuse', delete: 'Delete'}[decision]|trans({}, domain) }}
                                                    </button>
                                                </form>
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card mb-3">
                    <div class="card-header">{{ 'Who and what'|trans({}, domain) }}</div>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">
                            <span class="text-muted d-block">{{ 'Customer'|trans({}, domain) }}</span>
                            {% if customerUrl %}
                                <a href="{{ customerUrl }}" data-testid="product-question-customer-link">{{ 'Open the customer record'|trans({}, domain) }}</a>
                            {% else %}
                                {{ 'Deleted account'|trans({}, domain) }}
                            {% endif %}
                        </li>
                        <li class="list-group-item" data-testid="product-question-notify-author">
                            <span class="text-muted d-block">{{ 'Emails to the author about new answers'|trans({}, domain) }}</span>
                            {{ question.notifyAuthor ? 'On'|trans({}, domain) : 'Stopped by the author'|trans({}, domain) }}
                        </li>
                        <li class="list-group-item">
                            <span class="text-muted d-block">{{ 'Product'|trans({}, domain) }}</span>
                            <a href="{{ productUrl }}" data-testid="product-question-product-link">{{ productTitle ?? ('Product #%id%'|trans({'%id%': question.productId}, domain)) }}</a>
                        </li>
                        {% if officialAnswer and officialAnswer.publishedAt %}
                            <li class="list-group-item">
                                <span class="text-muted d-block">{{ 'Answered on'|trans({}, domain) }}</span>
                                {{ officialAnswer.publishedAt|date('d/m/Y H:i') }}
                            </li>
                        {% endif %}
                    </ul>
                </div>

                <div class="card">
                    <div class="card-header">{{ 'Moderation'|trans({}, domain) }}</div>
                    <div class="card-body d-flex flex-wrap gap-2">
                        {% if questionStatus.value != 1 %}
                            <form method="POST" action="{{ path('productquestion_module_publish', {id: question.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrfToken }}">
                                <button type="submit" class="btn btn-outline-success" data-testid="product-question-publish-question">
                                    {{ 'Publish without answering'|trans({}, domain) }}
                                </button>
                            </form>
                        {% endif %}
                        <form method="POST" action="{{ path('productquestion_module_refuse', {id: question.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrfToken }}">
                            <button type="submit" class="btn btn-outline-danger" data-testid="product-question-refuse">
                                {{ 'Refuse the question'|trans({}, domain) }}
                            </button>
                        </form>
                        <form method="POST" action="{{ path('productquestion_module_delete', {id: question.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrfToken }}">
                            <button type="submit" class="btn btn-outline-secondary" data-testid="product-question-delete">
                                {{ 'Delete'|trans({}, domain) }}
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
