{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% set domain = 'productquestion.bo.default-twig' %}

{% block title %}{{ 'Customer questions'|trans({}, domain) }}{% endblock %}
{% block body_testid %}product-question-list-page{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans({}, domain) }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'Customer questions'|trans({}, domain) }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    <div class="container-fluid" data-testid="product-question-list-content">
        <h1 class="h3 mb-3">{{ 'Customer questions'|trans({}, domain) }}</h1>

        {% include 'ProductQuestion/_status_tabs.html.twig' %}

        {% include 'ProductQuestion/_filters.html.twig' %}

        {% if rows is empty %}
            <div class="alert alert-info" data-testid="product-question-empty">
                {{ 'No question matches this selection.'|trans({}, domain) }}
            </div>
        {% else %}
            {% include 'ProductQuestion/_table.html.twig' %}
            {% include 'ProductQuestion/_pagination.html.twig' %}
        {% endif %}
    </div>
{% endblock %}
