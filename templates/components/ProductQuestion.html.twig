{# The theme's form theme for every field, plus the module's own block for the textarea, which
   the theme renders two rows high. #}
{% form_theme form with flexy_form_themes|merge(['@ProductQuestionModule/form/product_question_form_theme.html.twig']) only %}

{# Read out here: `this` rescopes inside the nested <twig:> components. #}
{% set labels = this.labels %}
{% set questions = this.questions %}
{% set canAnswer = this.canAnswer %}
{% set open = this.open %}

{# Geometry lives in the module's own stylesheet (assets/product-question.css, linked by the
   theme hook): utility classes only this module uses are not in the theme's Tailwind sources,
   so they would never be generated. What is kept from the theme is its type scale and its
   colours, which are what makes the block look like the rest of the shop. #}
{# No id of its own: the live component carries one already, and two id attributes on one
   element is invalid markup. #}
{# Closed with nothing published: the page stays as it is without the module. A live component
   still needs its root element, which is left empty and hidden. #}
{% if not open and questions is empty %}
<section {{ attributes.defaults({class: 'ProductQuestion'}) }} hidden data-testid="product-question-block-closed"></section>
{% else %}
<section {{ attributes.defaults({class: 'ProductQuestion container-l'}) }} data-testid="product-question-block">
    <header class="ProductQuestion-header">
        <h2 class="h2 text-black">{{ labels.title }}</h2>
    </header>

    {% if questions is not empty %}
        <ul class="ProductQuestion-list" data-testid="product-question-list">
            {% for question in questions %}
                <li class="ProductQuestion-item" data-testid="product-question-item-{{ question.id }}">
                    <p class="ProductQuestion-question paragraph-2 text-black">{{ question.content|nl2br }}</p>
                    {% if question.answers is not empty %}
                        <ul class="ProductQuestion-answers">
                            {% for answer in question.answers %}
                                <li class="ProductQuestion-answer{{ answer.official ? ' ProductQuestion-answer--official' : '' }}" data-testid="product-question-answer-{{ answer.id }}">
                                    <p class="ProductQuestion-answerLabel paragraph-4 text-grey">
                                        {{ answer.official ? labels.answer : labels.customerAnswer }}
                                        {% if answer.publishedAt %}
                                            <time datetime="{{ answer.publishedAt|date('Y-m-d') }}">{{ answer.publishedAt|date('d/m/Y') }}</time>
                                        {% endif %}
                                    </p>
                                    <p class="paragraph-3 text-black">{{ answer.content|nl2br }}</p>
                                    <div class="ProductQuestion-helpful">
                                        <span class="paragraph-4 text-grey" data-testid="product-question-helpful-count-{{ answer.id }}">{{ labels.helpfulCount|replace({'%count%': answer.helpfulCount}) }}</span>
                                        <twig:Molecules:Button:Base
                                            text="{{ labels.helpful }}"
                                            color="minimal"
                                            size="small"
                                            data-action="live#action"
                                            data-live-action-param="vote"
                                            data-live-answer-id-param="{{ answer.id }}"
                                            data-testid="product-question-helpful-{{ answer.id }}"
                                        />
                                    </div>
                                    {% if this.voteFeedback and this.voteFeedbackAnswerId == answer.id %}
                                        <p class="paragraph-4 text-black" role="status" data-testid="product-question-vote-feedback-{{ answer.id }}">{{ this.voteFeedback }}</p>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <p class="ProductQuestion-noAnswer paragraph-4 text-grey">{{ labels.noAnswer }}</p>
                    {% endif %}

                    {% if this.answerFeedback and this.answerFeedbackQuestionId == question.id %}
                        <twig:Molecules:SnackBar:Base variant="{{ this.answerFeedbackIsError ? 'error' : 'success' }}" withIcon text="{{ this.answerFeedback }}" data-testid="product-question-answer-feedback-{{ question.id }}" />
                    {% endif %}

                    {% if canAnswer %}
                        {% if this.answeringQuestionId == question.id %}
                            <div class="ProductQuestion-answerForm" data-testid="product-question-answer-form-{{ question.id }}">
                                <twig:Fields:TextArea:Base
                                    label="{{ labels.yourAnswer }}"
                                    name="answerContent"
                                    id="product-question-answer-{{ question.id }}-content"
                                    rows="3"
                                    value="{{ this.answerContent }}"
                                    required
                                    textarea:data-model="answerContent"
                                    textarea:maxlength="5000"
                                />
                                <div class="ProductQuestion-answerActions">
                                    <twig:Molecules:Button:Base text="{{ labels.sendAnswer }}" data-action="live#action" data-live-action-param="sendAnswer" data-testid="product-question-answer-send-{{ question.id }}" />
                                    <twig:Molecules:Button:Base text="{{ labels.cancel }}" color="minimal" data-action="live#action" data-live-action-param="cancelAnswer" />
                                </div>
                            </div>
                        {% else %}
                            <twig:Molecules:Button:Base
                                text="{{ labels.answerThis }}"
                                color="secondary"
                                size="small"
                                class="ProductQuestion-answerOpen"
                                data-action="live#action"
                                data-live-action-param="openAnswer"
                                data-live-question-id-param="{{ question.id }}"
                                data-testid="product-question-answer-open-{{ question.id }}"
                            />
                        {% endif %}
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    {% else %}
        <p class="ProductQuestion-empty paragraph-3 text-grey" data-testid="product-question-empty">{{ labels.empty }}</p>
    {% endif %}

    {% if this.feedback %}
        <twig:Molecules:SnackBar:Base variant="success" withIcon text="{{ this.feedback }}" class="ProductQuestion-notice" data-testid="product-question-feedback" />
    {% endif %}

    {% if this.error %}
        <twig:Molecules:SnackBar:Base variant="error" withIcon text="{{ this.error }}" class="ProductQuestion-notice" data-testid="product-question-error" />
    {% endif %}

    {% if this.canAsk %}
        <div class="ProductQuestion-form">
            <h3 class="h4 text-black ProductQuestion-formTitle">{{ labels.ask }}</h3>

            {{ form_start(form, {
                attr: {
                    class: 'ProductQuestion-formFields',
                    'data-action': 'live#action:prevent',
                    'data-live-action-param': 'ask',
                    'data-testid': 'product-question-form',
                },
            }) }}

            {# The Flexy form theme renders nothing for `form_errors`: the errors carried by the
               form itself rather than by its field are shown here. #}
            {% for formError in form.vars.errors %}
                <twig:Molecules:SnackBar:Base variant="error" withIcon text="{{ formError.message }}" />
            {% endfor %}

            {{ form_row(form.content, {attr: {rows: 4}}) }}

            <twig:Molecules:Button:Base text="{{ labels.send }}" type="submit" class="ProductQuestion-submit" data-testid="product-question-submit" />

            {{ form_end(form) }}
        </div>
    {% elseif not open %}
        <p class="ProductQuestion-closed paragraph-3 text-grey" data-testid="product-question-closed">{{ labels.closed }}</p>
    {% else %}
        <p class="ProductQuestion-signIn paragraph-3 text-black" data-testid="product-question-sign-in">
            {{ labels.signIn }}
            <a class="ProductQuestion-signInLink" href="{{ path('customer_login') }}">{{ labels.signInLink }}</a>
        </p>
    {% endif %}
</section>
{% endif %}
